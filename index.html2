<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Malak Shop</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap');

:root {
  --bg:        #0a0a0a;
  --surface:   #111111;
  --surface2:  #1a1a1a;
  --surface3:  #222222;
  --border:    #2a2a2a;
  --border2:   #333333;
  --text:      #f0f0f0;
  --text-muted:#888888;
  --text-dim:  #555555;
  --green-bg:  #0d1f0d;
  --green-text:#4caf50;
  --red:       #c0392b;
  --radius:    10px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Tajawal', sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ═══ HEADER ═══ */
.header {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  height: 58px;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 20px;
  position: sticky; top: 0; z-index: 100;
}
.brand-name { font-size: 18px; font-weight: 800; color: var(--text); letter-spacing: 1px; }
.brand-sub  { font-size: 11px; color: var(--text-dim); }

.btn-data {
  background: var(--surface3); border: 1px solid var(--border2);
  color: var(--text); padding: 8px 22px; border-radius: var(--radius);
  cursor: pointer; font-family: 'Tajawal', sans-serif;
  font-size: 14px; font-weight: 700; transition: background 0.2s;
}
.btn-data:hover { background: var(--border2); border-color: #555; }

/* ═══ CHAT PAGE ═══ */
#chat-page { display: flex; flex-direction: column; flex: 1; }
#chat-page.hidden { display: none; }

.chat-body {
  flex: 1; max-width: 720px; width: 100%;
  margin: 0 auto; padding: 20px 16px 0;
  display: flex; flex-direction: column;
}
.messages-area {
  flex: 1; overflow-y: auto;
  display: flex; flex-direction: column;
  gap: 10px; padding-bottom: 10px; scroll-behavior: smooth;
}
.messages-area::-webkit-scrollbar { width: 3px; }
.messages-area::-webkit-scrollbar-thumb { background: var(--border2); }

/* ═══ MESSAGES ═══ */
.msg-row { display: flex; gap: 10px; animation: slideIn 0.28s ease; }
.msg-row.bot  { align-items: flex-end; }
.msg-row.user { flex-direction: row-reverse; align-items: flex-end; }
@keyframes slideIn {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}
.avatar {
  width: 32px; height: 32px; border-radius: 50%;
  flex-shrink: 0; display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 800;
}
.avatar.bot  { background: var(--surface3); border: 1px solid var(--border2); color: var(--text-muted); }
.avatar.user { background: var(--border2);  border: 1px solid #444;           color: var(--text-muted); }
.bubble {
  max-width: 76%; padding: 12px 16px; border-radius: var(--radius);
  font-size: 14px; line-height: 1.7; word-break: break-word;
}
.bubble.bot  { background: var(--surface);  border: 1px solid var(--border);  color: var(--text); border-bottom-right-radius: 3px; }
.bubble.user { background: var(--surface3); border: 1px solid var(--border2); color: var(--text); border-bottom-left-radius: 3px; }

/* ═══ TYPING ═══ */
.typing-row { display: flex; gap: 10px; align-items: flex-end; }
.typing-bubble {
  background: var(--surface); border: 1px solid var(--border);
  padding: 14px 18px; border-radius: var(--radius); border-bottom-right-radius: 3px;
  display: flex; gap: 5px; align-items: center;
}
.dot { width: 6px; height: 6px; background: var(--text-dim); border-radius: 50%; animation: bounce 1.2s infinite; }
.dot:nth-child(2) { animation-delay: 0.16s; }
.dot:nth-child(3) { animation-delay: 0.32s; }
@keyframes bounce { 0%,60%,100% { transform: translateY(0); } 30% { transform: translateY(-6px); } }

/* ═══ CHAT PRODUCT CARDS ═══ */
.products-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
  gap: 8px; margin-top: 10px;
}
.product-card {
  background: var(--surface2); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 12px 10px;
  text-align: center; transition: border-color 0.2s;
}
.product-card:hover { border-color: #555; }
.product-card-img { width: 100%; height: 90px; object-fit: cover; border-radius: 7px; margin-bottom: 8px; background: var(--surface3); display: block; }
.product-card-noimg { width: 100%; height: 90px; background: var(--surface3); border-radius: 7px; margin-bottom: 8px; display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--text-dim); }
.product-name  { font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
.product-desc  { font-size: 11px; color: var(--text-muted); margin-bottom: 8px; }
.product-price { display: inline-block; background: var(--surface3); border: 1px solid var(--border2); color: var(--text); font-size: 13px; font-weight: 700; padding: 3px 10px; border-radius: 50px; }

/* ═══ DELIVERY TABLE ═══ */
.delivery-table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
.delivery-table th { background: var(--surface3); color: var(--text-muted); padding: 8px 12px; text-align: right; font-weight: 700; border-bottom: 1px solid var(--border); }
.delivery-table td { padding: 7px 12px; border-bottom: 1px solid var(--border); color: var(--text); }
.delivery-table tr:last-child td { border-bottom: none; }

/* ═══ QUICK BUTTONS ═══ */
.quick-btns { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 8px; }
.qbtn {
  padding: 8px 18px; border-radius: var(--radius); border: 1px solid var(--border2);
  background: var(--surface2); color: var(--text); font-family: 'Tajawal', sans-serif;
  font-size: 13px; font-weight: 700; cursor: pointer;
  transition: background 0.18s, border-color 0.18s; white-space: nowrap;
}
.qbtn:hover { background: var(--surface3); border-color: #555; }

/* ═══ ORDER SUMMARY ═══ */
.order-summary { background: var(--surface2); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px; margin-top: 8px; }
.summary-title { font-size: 14px; font-weight: 800; color: var(--text); margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
.summary-row { display: flex; justify-content: space-between; padding: 6px 0; font-size: 13px; border-bottom: 1px solid var(--border); }
.summary-row:last-child { border-bottom: none; }
.summary-label { color: var(--text-muted); }
.summary-value { font-weight: 700; color: var(--text); }

/* ═══ INPUT AREA ═══ */
.input-area-wrap { background: var(--surface); border-top: 1px solid var(--border); position: sticky; bottom: 0; }
.input-inner { max-width: 720px; margin: 0 auto; padding: 12px 16px; display: flex; gap: 10px; align-items: center; }
.chat-input {
  flex: 1; background: var(--surface2); border: 1px solid var(--border2);
  border-radius: var(--radius); padding: 10px 16px;
  font-family: 'Tajawal', sans-serif; font-size: 14px; color: var(--text);
  outline: none; transition: border-color 0.2s; min-height: 42px; max-height: 120px; overflow-y: auto;
}
.chat-input:focus { border-color: #555; }
.chat-input:empty::before { content: attr(data-placeholder); color: var(--text-dim); pointer-events: none; }
.send-btn {
  width: 42px; height: 42px; background: var(--surface3); border: 1px solid var(--border2);
  border-radius: var(--radius); color: var(--text); font-size: 16px;
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  transition: background 0.2s; flex-shrink: 0;
}
.send-btn:hover { background: #333; border-color: #555; }

/* ═══ CODE POPUP ═══ */
.overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.88); z-index: 500; display: flex; align-items: center; justify-content: center; }
.overlay.hidden { display: none; }
.popup { background: var(--surface); border: 1px solid var(--border2); border-radius: 14px; padding: 32px 28px; width: 90%; max-width: 340px; animation: popIn 0.22s ease; }
@keyframes popIn { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
.popup-title { font-size: 18px; font-weight: 800; color: var(--text); margin-bottom: 6px; }
.popup-sub   { font-size: 13px; color: var(--text-muted); margin-bottom: 20px; }
.popup-input {
  width: 100%; background: var(--surface2); border: 1px solid var(--border2);
  border-radius: var(--radius); padding: 11px 16px;
  font-family: 'Tajawal', sans-serif; font-size: 18px; text-align: center;
  letter-spacing: 4px; font-weight: 700; color: var(--text); outline: none;
  transition: border-color 0.2s; margin-bottom: 8px;
}
.popup-input:focus { border-color: #555; }
.popup-input.error { border-color: var(--red); animation: shake 0.3s ease; }
@keyframes shake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-7px); } 75% { transform: translateX(7px); } }
.popup-error { font-size: 13px; color: var(--red); font-weight: 600; margin-bottom: 14px; min-height: 18px; text-align: center; }
.popup-actions { display: flex; gap: 8px; }
.btn-confirm {
  flex: 1; background: var(--surface3); border: 1px solid var(--border2);
  border-radius: var(--radius); padding: 11px;
  font-family: 'Tajawal', sans-serif; font-size: 15px; font-weight: 700;
  color: var(--text); cursor: pointer; transition: background 0.18s;
}
.btn-confirm:hover { background: #333; border-color: #555; }
.btn-cancel {
  flex: 1; background: transparent; border: 1px solid var(--border);
  border-radius: var(--radius); padding: 11px;
  font-family: 'Tajawal', sans-serif; font-size: 15px; font-weight: 700;
  color: var(--text-muted); cursor: pointer; transition: border-color 0.18s;
}
.btn-cancel:hover { border-color: #555; color: var(--text); }

/* ═══ ADMIN PANEL ═══ */
#admin-page { display: none; flex-direction: column; min-height: 100vh; }
#admin-page.active { display: flex; }
.admin-header {
  background: var(--surface); border-bottom: 1px solid var(--border);
  padding: 0 24px; height: 58px;
  display: flex; align-items: center; justify-content: space-between;
  position: sticky; top: 0; z-index: 100;
}
.admin-title { font-size: 17px; font-weight: 800; color: var(--text); }
.btn-back {
  background: var(--surface3); border: 1px solid var(--border2);
  color: var(--text); padding: 8px 20px; border-radius: var(--radius);
  cursor: pointer; font-family: 'Tajawal', sans-serif;
  font-size: 14px; font-weight: 700; transition: background 0.2s;
}
.btn-back:hover { background: #333; border-color: #555; }

/* ═══ TABS ═══ */
.tabs-bar { background: var(--surface); border-bottom: 1px solid var(--border); display: flex; padding: 0 24px; overflow-x: auto; }
.tabs-bar::-webkit-scrollbar { height: 0; }
.tab-btn {
  background: none; border: none; border-bottom: 2px solid transparent;
  color: var(--text-muted); padding: 14px 18px;
  font-family: 'Tajawal', sans-serif; font-size: 14px; font-weight: 700;
  cursor: pointer; transition: all 0.2s; white-space: nowrap;
}
.tab-btn:hover { color: var(--text); }
.tab-btn.active { color: var(--text); border-bottom-color: var(--text); }
.tab-panel { display: none; flex: 1; padding: 24px; overflow-y: auto; }
.tab-panel.active { display: block; }

/* ═══ ORDERS TABLE ═══ */
.table-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; overflow-x: auto; }
.orders-table { width: 100%; border-collapse: collapse; min-width: 780px; }
.orders-table th { background: var(--surface2); color: var(--text-muted); padding: 13px 14px; text-align: right; font-size: 13px; font-weight: 700; border-bottom: 1px solid var(--border); white-space: nowrap; }
.orders-table td { padding: 13px 14px; font-size: 13px; color: var(--text); border-bottom: 1px solid var(--border); vertical-align: middle; }
.orders-table tr:last-child td { border-bottom: none; }
.orders-table tr.confirmed td { background: var(--green-bg); color: var(--green-text); }
.btn-action {
  background: transparent; border: 1px solid var(--border2); color: var(--text-muted);
  padding: 6px 12px; border-radius: 7px; cursor: pointer;
  font-family: 'Tajawal', sans-serif; font-size: 12px; font-weight: 700;
  transition: all 0.18s; white-space: nowrap;
}
.btn-action.green:hover  { border-color: var(--green-text); color: var(--green-text); }
.btn-action.red:hover    { border-color: var(--red); color: var(--red); }
.btn-action.active-green { border-color: var(--green-text); color: var(--green-text); }

/* ═══ WAREHOUSE (MAKHZAN) ═══ */
.wh-toolbar {
  display: flex; flex-wrap: wrap; gap: 10px;
  margin-bottom: 18px; align-items: center;
}
.wh-search {
  flex: 1; min-width: 180px;
  background: var(--surface2); border: 1px solid var(--border2);
  border-radius: var(--radius); padding: 10px 14px;
  font-family: 'Tajawal', sans-serif; font-size: 14px; color: var(--text);
  outline: none; transition: border-color 0.2s;
}
.wh-search:focus { border-color: #555; }
.wh-search::placeholder { color: var(--text-dim); }
.wh-date {
  background: var(--surface2); border: 1px solid var(--border2);
  border-radius: var(--radius); padding: 10px 14px;
  font-family: 'Tajawal', sans-serif; font-size: 14px; color: var(--text);
  outline: none; transition: border-color 0.2s; cursor: pointer;
  color-scheme: dark;
}
.wh-date:focus { border-color: #555; }
.wh-clear-btn {
  background: transparent; border: 1px solid var(--border2); color: var(--text-muted);
  padding: 10px 14px; border-radius: var(--radius); cursor: pointer;
  font-family: 'Tajawal', sans-serif; font-size: 13px; font-weight: 700;
  transition: all 0.18s; white-space: nowrap;
}
.wh-clear-btn:hover { border-color: #555; color: var(--text); }

.wh-stats { display: flex; gap: 12px; margin-bottom: 18px; flex-wrap: wrap; }
.wh-stat {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 10px 18px;
  font-size: 13px; color: var(--text-muted);
}
.wh-stat span { font-weight: 800; color: var(--text); margin-right: 4px; }

/* ═══ PRODUCTS MANAGEMENT ═══ */
.pm-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
.pm-title { font-size: 16px; font-weight: 800; color: var(--text); }
.btn-add-product {
  background: var(--surface3); border: 1px solid var(--border2); color: var(--text);
  padding: 9px 20px; border-radius: var(--radius); cursor: pointer;
  font-family: 'Tajawal', sans-serif; font-size: 14px; font-weight: 700; transition: background 0.2s;
}
.btn-add-product:hover { background: #333; border-color: #555; }
.pm-list { display: flex; flex-direction: column; gap: 10px; }
.pm-card {
  background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
  padding: 14px; display: flex; align-items: center; gap: 14px; transition: border-color 0.2s;
}
.pm-card:hover { border-color: var(--border2); }
.pm-card-img    { width: 72px; height: 72px; object-fit: cover; border-radius: 8px; flex-shrink: 0; background: var(--surface2); }
.pm-card-noimg  { width: 72px; height: 72px; border-radius: 8px; background: var(--surface2); flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 10px; color: var(--text-dim); text-align: center; }
.pm-card-info   { flex: 1; min-width: 0; }
.pm-card-name   { font-size: 15px; font-weight: 700; color: var(--text); margin-bottom: 3px; }
.pm-card-desc   { font-size: 12px; color: var(--text-muted); margin-bottom: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pm-card-price  { font-size: 13px; font-weight: 700; color: var(--text); }
.pm-card-actions { display: flex; gap: 7px; flex-shrink: 0; }
.pm-btn {
  background: transparent; border: 1px solid var(--border2); color: var(--text-muted);
  padding: 6px 14px; border-radius: 7px; cursor: pointer;
  font-family: 'Tajawal', sans-serif; font-size: 12px; font-weight: 700; transition: all 0.18s; white-space: nowrap;
}
.pm-btn.edit:hover { border-color: #888; color: var(--text); }
.pm-btn.del:hover  { border-color: var(--red); color: var(--red); }

/* ═══ PRODUCT FORM MODAL ═══ */
.modal-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.9);
  z-index: 900; display: flex; align-items: center; justify-content: center; padding: 20px;
}
.modal-overlay.hidden { display: none; }
.modal {
  background: var(--surface); border: 1px solid var(--border2); border-radius: 16px; padding: 28px;
  width: 100%; max-width: 440px; animation: popIn 0.22s ease; max-height: 90vh; overflow-y: auto;
}
.modal-title { font-size: 17px; font-weight: 800; color: var(--text); margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid var(--border); }
.form-group  { margin-bottom: 16px; }
.form-label  { display: block; font-size: 13px; font-weight: 700; color: var(--text-muted); margin-bottom: 7px; }
.form-input  { width: 100%; background: var(--surface2); border: 1px solid var(--border2); border-radius: var(--radius); padding: 10px 14px; font-family: 'Tajawal', sans-serif; font-size: 14px; color: var(--text); outline: none; transition: border-color 0.2s; }
.form-input:focus { border-color: #555; }
.form-input::placeholder { color: var(--text-dim); }
textarea.form-input { resize: vertical; min-height: 70px; }
.img-picker-area { border: 1.5px dashed var(--border2); border-radius: var(--radius); padding: 20px; text-align: center; cursor: pointer; transition: border-color 0.2s; background: var(--surface2); }
.img-picker-area:hover { border-color: #555; }
.img-picker-label { font-size: 13px; color: var(--text-muted); font-weight: 600; cursor: pointer; display: block; }
.img-preview { width: 100%; height: 140px; object-fit: cover; border-radius: 8px; margin-bottom: 8px; display: none; }
.img-preview.visible { display: block; }
.modal-actions { display: flex; gap: 10px; margin-top: 20px; }
.modal-save  { flex: 1; background: var(--surface3); border: 1px solid var(--border2); border-radius: var(--radius); padding: 12px; font-family: 'Tajawal', sans-serif; font-size: 15px; font-weight: 700; color: var(--text); cursor: pointer; transition: background 0.18s; }
.modal-save:hover { background: #333; border-color: #555; }
.modal-close { flex: 1; background: transparent; border: 1px solid var(--border); border-radius: var(--radius); padding: 12px; font-family: 'Tajawal', sans-serif; font-size: 15px; font-weight: 700; color: var(--text-muted); cursor: pointer; transition: border-color 0.18s; }
.modal-close:hover { border-color: #555; color: var(--text); }

/* ═══ MISC ═══ */
.section-label { font-size: 11px; font-weight: 700; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 8px; }
.orders-meta   { font-size: 12px; color: var(--text-dim); }
.empty-state      { text-align: center; padding: 60px 20px; color: var(--text-dim); }
.empty-state-text { font-size: 16px; font-weight: 600; }

/* ═══ TOAST ═══ */
.toast {
  position: fixed; bottom: 74px; left: 50%;
  transform: translateX(-50%) translateY(10px);
  background: var(--surface3); border: 1px solid var(--border2);
  color: var(--text); padding: 10px 24px; border-radius: 50px;
  font-size: 14px; font-weight: 700; z-index: 2000;
  opacity: 0; transition: all 0.3s; pointer-events: none; white-space: nowrap;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

@media (max-width: 600px) {
  .bubble { max-width: 88%; }
  .products-grid { grid-template-columns: 1fr 1fr; }
  .tab-panel { padding: 14px; }
  .pm-card { flex-wrap: wrap; }
  .wh-toolbar { flex-direction: column; }
  .wh-search, .wh-date { width: 100%; }
}
</style>
</head>
<body>

<!-- TOAST -->
<div class="toast" id="toast">تم الحفظ</div>

<!-- CODE POPUP -->
<div class="overlay hidden" id="code-overlay">
  <div class="popup">
    <div class="popup-title">كود الدخول</div>
    <div class="popup-sub">ادخل الكود السري للوصول الى البيانات</div>
    <input type="password" class="popup-input" id="code-input"
      placeholder="- - - - -" maxlength="10"
      oninput="clearError()" onkeydown="if(event.key==='Enter') checkCode()">
    <div class="popup-error" id="code-error"></div>
    <div class="popup-actions">
      <button class="btn-confirm" onclick="checkCode()">دخول</button>
      <button class="btn-cancel"  onclick="closeCodePopup()">الغاء</button>
    </div>
  </div>
</div>

<!-- PRODUCT FORM MODAL -->
<div class="modal-overlay hidden" id="product-modal">
  <div class="modal">
    <div class="modal-title" id="modal-title">اضافة منتج جديد</div>
    <div class="form-group">
      <label class="form-label">اسم المنتج</label>
      <input type="text" class="form-input" id="f-name" placeholder="مثال: فستان سهرة">
    </div>
    <div class="form-group">
      <label class="form-label">السعر</label>
      <input type="text" class="form-input" id="f-price" placeholder="مثال: 4500 دج">
    </div>
    <div class="form-group">
      <label class="form-label">الوصف</label>
      <textarea class="form-input" id="f-desc" placeholder="وصف مختصر للمنتج"></textarea>
    </div>
    <div class="form-group">
      <label class="form-label">صورة المنتج</label>
      <div class="img-picker-area" onclick="document.getElementById('f-img-input').click()">
        <img id="f-img-preview" class="img-preview" src="" alt="">
        <label class="img-picker-label" id="img-picker-label">اضغط لاختيار صورة من الجهاز</label>
      </div>
      <input type="file" id="f-img-input" accept="image/*" style="display:none" onchange="onImagePicked(event)">
    </div>
    <div class="modal-actions">
      <button class="modal-save"  onclick="saveProduct()">حفظ المنتج</button>
      <button class="modal-close" onclick="closeProductModal()">الغاء</button>
    </div>
  </div>
</div>

<!-- ════════ CHAT PAGE ════════ -->
<div id="chat-page">
  <header class="header">
    <div>
      <div class="brand-name">Malak Shop</div>
      <div class="brand-sub">متجر الازياء النسائية</div>
    </div>
    <button class="btn-data" onclick="openCodePopup()">البيانات</button>
  </header>
  <div class="chat-body">
    <div class="messages-area" id="messages-area"></div>
  </div>
  <div class="input-area-wrap">
    <div class="input-inner">
      <div class="chat-input" id="chat-input" contenteditable="true"
        data-placeholder="اكتب رسالتك..."
        onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendMessage();}">
      </div>
      <button class="send-btn" onclick="sendMessage()">&#10148;</button>
    </div>
  </div>
</div>

<!-- ════════ ADMIN PAGE ════════ -->
<div id="admin-page">
  <div class="admin-header">
    <div class="admin-title">لوحة الادارة</div>
    <button class="btn-back" onclick="goBack()">الرجوع</button>
  </div>

  <div class="tabs-bar">
    <button class="tab-btn active"  onclick="switchTab('orders')">الطلبات</button>
    <button class="tab-btn"         onclick="switchTab('warehouse')">المخزن</button>
    <button class="tab-btn"         onclick="switchTab('products')">ادارة المنتجات</button>
  </div>

  <!-- TAB: ORDERS -->
  <div class="tab-panel active" id="tab-orders">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
      <div style="font-size:16px;font-weight:800;">جدول الطلبات</div>
      <div class="orders-meta" id="orders-meta">0 طلب</div>
    </div>
    <div class="table-wrap">
      <table class="orders-table">
        <thead>
          <tr>
            <th>#</th><th>الاسم</th><th>رقم الهاتف</th><th>المنتج</th>
            <th>الكمية</th><th>مكان التوصيل</th><th>التاريخ</th>
            <th>هل تم التاكيد</th><th>هل تم الارسال</th>
          </tr>
        </thead>
        <tbody id="orders-tbody"></tbody>
      </table>
      <div class="empty-state hidden" id="empty-orders">
        <div class="empty-state-text">لا توجد طلبات</div>
      </div>
    </div>
  </div>

  <!-- TAB: WAREHOUSE -->
  <div class="tab-panel" id="tab-warehouse">
    <div style="font-size:16px;font-weight:800;margin-bottom:16px;">المخزن - الطلبات المرسلة</div>

    <div class="wh-toolbar">
      <input type="text"  class="wh-search" id="wh-search" placeholder="بحث بالاسم او رقم الهاتف..." oninput="renderWarehouse()">
      <input type="date"  class="wh-date"   id="wh-date"   onchange="renderWarehouse()">
      <button class="wh-clear-btn" onclick="clearWhFilters()">مسح الفلتر</button>
    </div>

    <div class="wh-stats" id="wh-stats"></div>

    <div class="table-wrap">
      <table class="orders-table">
        <thead>
          <tr>
            <th>#</th><th>الاسم</th><th>رقم الهاتف</th><th>المنتج</th>
            <th>الكمية</th><th>مكان التوصيل</th><th>التاريخ</th>
            <th>حذف نهائي</th>
          </tr>
        </thead>
        <tbody id="warehouse-tbody"></tbody>
      </table>
      <div class="empty-state hidden" id="empty-warehouse">
        <div class="empty-state-text">لا توجد طلبات</div>
      </div>
    </div>
  </div>

  <!-- TAB: PRODUCTS -->
  <div class="tab-panel" id="tab-products">
    <div class="pm-header">
      <div class="pm-title">قائمة المنتجات</div>
      <button class="btn-add-product" onclick="openProductModal()">اضافة منتج جديد</button>
    </div>
    <div class="pm-list" id="pm-list"></div>
    <div class="empty-state hidden" id="empty-products">
      <div class="empty-state-text">لا توجد منتجات</div>
    </div>
  </div>
</div>

<!-- ════════ JAVASCRIPT ════════ -->
<script>
// ── CONFIG ──────────────────────────────────
const SECRET_CODE = '2008M';

const DEFAULT_PRODUCTS = [
  { id:1, name:'فستان سهرة انيق',  desc:'فستان فاخر للمناسبات',        price:'4500 دج', img:'' },
  { id:2, name:'حذاء كعب عالٍ',    desc:'جلد طبيعي بالوان متعددة',     price:'2800 دج', img:'' },
  { id:3, name:'حقيبة يد فاخرة',   desc:'جلد طبيعي بتصميم انيق',       price:'6000 دج', img:'' },
  { id:4, name:'مجوهرات ذهبية',     desc:'اكسسوار راقٍ لاطلالة مميزة', price:'8500 دج', img:'' },
  { id:5, name:'وشاح حرير',         desc:'حرير طبيعي ناعم',              price:'1800 دج', img:'' },
  { id:6, name:'نظارة شمسية',       desc:'عصرية بحماية UV 400',          price:'2200 دج', img:'' },
];

const WILAYAS = [
  { name:'الجزائر العاصمة', price:'300 دج', days:'1-2 يوم'  },
  { name:'وهران',            price:'450 دج', days:'2-3 ايام' },
  { name:'قسنطينة',          price:'450 دج', days:'2-3 ايام' },
  { name:'عنابة',            price:'500 دج', days:'2-3 ايام' },
  { name:'سطيف',             price:'500 دج', days:'2-4 ايام' },
  { name:'تيزي وزو',         price:'400 دج', days:'1-2 يوم'  },
  { name:'بجاية',            price:'450 دج', days:'2-3 ايام' },
  { name:'باقي الولايات',    price:'600 دج', days:'3-5 ايام' },
];

// ── STORAGE ─────────────────────────────────
function getProducts()     { try { const s = localStorage.getItem('malak_products'); return s ? JSON.parse(s) : JSON.parse(JSON.stringify(DEFAULT_PRODUCTS)); } catch { return JSON.parse(JSON.stringify(DEFAULT_PRODUCTS)); } }
function saveProducts(l)   { localStorage.setItem('malak_products', JSON.stringify(l)); }
function getOrders()       { try { return JSON.parse(localStorage.getItem('malak_orders')    || '[]'); } catch { return []; } }
function saveOrders(l)     { localStorage.setItem('malak_orders',    JSON.stringify(l)); }
function getWarehouse()    { try { return JSON.parse(localStorage.getItem('malak_warehouse') || '[]'); } catch { return []; } }
function saveWarehouse(l)  { localStorage.setItem('malak_warehouse', JSON.stringify(l)); }

if (!localStorage.getItem('malak_products')) saveProducts(DEFAULT_PRODUCTS);

// ── CHAT STATE ───────────────────────────────
let step  = 'welcome';
let order = {};

// ── CHAT HELPERS ─────────────────────────────
const area    = document.getElementById('messages-area');
const scrollB = () => area.scrollTop = area.scrollHeight;

function addMsg(html, type = 'bot') {
  const row = document.createElement('div'); row.className = 'msg-row ' + type;
  const av  = document.createElement('div'); av.className  = 'avatar '  + type; av.textContent = type === 'bot' ? 'M' : 'A';
  const bub = document.createElement('div'); bub.className = 'bubble '  + type; bub.innerHTML  = html;
  row.appendChild(av); row.appendChild(bub);
  area.appendChild(row); scrollB();
}

function showTyping() {
  const row = document.createElement('div'); row.className = 'typing-row'; row.id = 'typing-ind';
  row.innerHTML = '<div class="avatar bot">M</div><div class="typing-bubble"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>';
  area.appendChild(row); scrollB();
}
function hideTyping() { const t = document.getElementById('typing-ind'); if (t) t.remove(); }

function botReply(html, delay = 750) {
  showTyping();
  return new Promise(r => setTimeout(() => { hideTyping(); addMsg(html, 'bot'); r(); }, delay));
}

// ── BUILD PRODUCT HTML ───────────────────────
function buildChatProductsHtml() {
  const products = getProducts();
  const cards = products.map(p => `
    <div class="product-card">
      ${p.img ? `<img class="product-card-img" src="${p.img}" alt="${p.name}">` : `<div class="product-card-noimg">لا توجد صورة</div>`}
      <div class="product-name">${p.name}</div>
      <div class="product-desc">${p.desc}</div>
      <div class="product-price">${p.price}</div>
    </div>`).join('');
  return `<div class="section-label">منتجاتنا</div><div class="products-grid">${cards}</div>`;
}

// ── WELCOME ──────────────────────────────────
async function startChat() {
  await new Promise(r => setTimeout(r, 400));
  const delivHtml = `
    <div class="section-label" style="margin-top:16px;">معلومات التوصيل</div>
    <table class="delivery-table">
      <thead><tr><th>الولاية</th><th>سعر التوصيل</th><th>المدة</th></tr></thead>
      <tbody>${WILAYAS.map(w=>`<tr><td>${w.name}</td><td>${w.price}</td><td>${w.days}</td></tr>`).join('')}</tbody>
    </table>`;
  await botReply(`
    <div style="font-size:20px;font-weight:900;margin-bottom:4px;">Malak Shop</div>
    <div style="font-size:13px;color:var(--text-muted);margin-bottom:14px;">متجر الازياء والاكسسوار النسائي</div>
    ${buildChatProductsHtml()}${delivHtml}`, 1000);
  await botReply(`
    <div style="font-weight:700;margin-bottom:10px;">هل تريد طلب منتج؟</div>
    <div class="quick-btns">
      <button class="qbtn" onclick="userChoice('نعم')">نعم</button>
      <button class="qbtn" onclick="userChoice('لا')">لا</button>
    </div>`, 500);
  step = 'ask_order';
}

// ── CHAT FLOW ────────────────────────────────
function userChoice(val) { addMsg(val, 'user'); handleStep(val); }

function sendMessage() {
  const inp = document.getElementById('chat-input');
  const txt = inp.innerText.trim(); if (!txt) return;
  inp.innerText = ''; addMsg(txt, 'user'); handleStep(txt);
}

async function handleStep(txt) {
  const t = txt.trim();

  if (step === 'ask_order') {
    if (t === 'نعم' || t.includes('نعم')) {
      step = 'get_name';
      await botReply('سنبدأ بتسجيل طلبك.<br><br><b>ما هو اسمك الكامل؟</b>');
    } else {
      step = 'done';
      await botReply('حسناً، نحن هنا دائماً اذا احتجت شيئاً.<div class="quick-btns" style="margin-top:10px;"><button class="qbtn" onclick="restartChat()">ابدأ من جديد</button></div>');
    }
    return;
  }

  if (step === 'get_name') {
    if (t.length < 3) { await botReply('يرجى ادخال اسمك الكامل.'); return; }
    order.name = t; step = 'get_phone';
    await botReply('شكراً ' + t + '.<br><br><b>ما هو رقم هاتفك؟</b>');
    return;
  }

  if (step === 'get_phone') {
    if (!/^[0-9+]{9,15}$/.test(t.replace(/\s/g,''))) { await botReply('يرجى ادخال رقم هاتف صحيح.'); return; }
    order.phone = t; step = 'get_product';
    const products = getProducts();
    const btns = products.map(p => '<button class="qbtn" onclick="userChoice(\'' + p.name.replace(/'/g,"&#39;") + '\')">' + p.name + ' - ' + p.price + '</button>').join('');
    await botReply('<b>اختر المنتج:</b><div class="quick-btns" style="flex-direction:column;align-items:flex-start;gap:5px;margin-top:8px;">' + btns + '</div>');
    return;
  }

  if (step === 'get_product') {
    const products = getProducts();
    const found = products.find(p => p.name === t || t.includes(p.name));
    if (!found) { await botReply('يرجى اختيار منتج من القائمة.'); return; }
    order.product = found.name; order.price = found.price; step = 'get_qty';
    const btns = [1,2,3,4,5].map(n => '<button class="qbtn" onclick="userChoice(\'' + n + '\')">' + n + '</button>').join('');
    await botReply('تم اختيار <b>' + found.name + '</b>.<br><br><b>كم الكمية؟</b><div class="quick-btns" style="margin-top:8px;">' + btns + '</div>');
    return;
  }

  if (step === 'get_qty') {
    const n = parseInt(t);
    if (!n || n < 1 || n > 100) { await botReply('يرجى ادخال كمية صحيحة.'); return; }
    order.qty = n; step = 'get_wilaya';
    const btns = WILAYAS.map(w => '<button class="qbtn" onclick="userChoice(\'' + w.name + '\')">' + w.name + ' (' + w.price + ')</button>').join('');
    await botReply('<b>اختر الولاية / مكان التوصيل:</b><div class="quick-btns" style="flex-wrap:wrap;margin-top:8px;">' + btns + '</div>');
    return;
  }

  if (step === 'get_wilaya') {
    const found = WILAYAS.find(w => w.name === t);
    if (!found) { await botReply('يرجى اختيار ولاية من القائمة.'); return; }
    order.wilaya = found.name; order.delivPrice = found.price; order.delivDays = found.days;
    step = 'confirm';
    await botReply(`
      <div class="order-summary">
        <div class="summary-title">ملخص الطلب</div>
        <div class="summary-row"><span class="summary-label">الاسم</span><span class="summary-value">${order.name}</span></div>
        <div class="summary-row"><span class="summary-label">الهاتف</span><span class="summary-value">${order.phone}</span></div>
        <div class="summary-row"><span class="summary-label">المنتج</span><span class="summary-value">${order.product}</span></div>
        <div class="summary-row"><span class="summary-label">الكمية</span><span class="summary-value">${order.qty}</span></div>
        <div class="summary-row"><span class="summary-label">الولاية</span><span class="summary-value">${order.wilaya}</span></div>
        <div class="summary-row"><span class="summary-label">التوصيل</span><span class="summary-value">${order.delivPrice} - ${order.delivDays}</span></div>
      </div>
      <div style="margin-top:12px;font-weight:700;">هل انت متاكد من هذه المعلومات؟</div>
      <div class="quick-btns" style="margin-top:8px;">
        <button class="qbtn" onclick="confirmOrder()">نعم، تاكيد الطلب</button>
        <button class="qbtn" onclick="editOrder()">تعديل</button>
      </div>`);
    return;
  }

  if (step === 'done') restartChat();
}

async function confirmOrder() {
  const now = new Date();
  const dateStr = now.toLocaleDateString('ar-DZ', { year:'numeric', month:'long', day:'numeric', hour:'2-digit', minute:'2-digit' });
  const list = getOrders();
  list.push({
    id: Date.now(), name: order.name, phone: order.phone,
    product: order.product, qty: order.qty, wilaya: order.wilaya,
    date: dateStr, dateISO: now.toISOString().slice(0,10), confirmed: false
  });
  saveOrders(list);
  order = {}; step = 'done';
  showToast('تم حفظ الطلب');
  await botReply('<div style="font-size:16px;font-weight:800;margin-bottom:6px;">تم تاكيد طلبك</div><div style="font-size:13px;color:var(--text-muted);margin-bottom:14px;">سيتم التواصل معك قريباً</div><div class="quick-btns"><button class="qbtn" onclick="restartChat()">طلب اخر</button></div>');
}

async function editOrder() { order = {}; step = 'get_name'; await botReply('سنبدأ من جديد.<br><br><b>ما هو اسمك الكامل؟</b>'); }
async function restartChat() { area.innerHTML = ''; order = {}; step = 'welcome'; await startChat(); }

// ── CODE POPUP ───────────────────────────────
function openCodePopup() {
  document.getElementById('code-overlay').classList.remove('hidden');
  document.getElementById('code-input').value = '';
  document.getElementById('code-error').textContent = '';
  setTimeout(() => document.getElementById('code-input').focus(), 80);
}
function closeCodePopup() { document.getElementById('code-overlay').classList.add('hidden'); }
function clearError() {
  document.getElementById('code-error').textContent = '';
  document.getElementById('code-input').classList.remove('error');
}
function checkCode() {
  const val = document.getElementById('code-input').value.trim();
  if (val === SECRET_CODE) { closeCodePopup(); openAdmin(); }
  else {
    const inp = document.getElementById('code-input');
    document.getElementById('code-error').textContent = 'حاول مجدداً';
    inp.classList.add('error'); inp.value = '';
    setTimeout(() => { inp.classList.remove('error'); inp.focus(); }, 400);
  }
}

// ── ADMIN PANEL ──────────────────────────────
function openAdmin() {
  document.getElementById('chat-page').classList.add('hidden');
  document.getElementById('admin-page').classList.add('active');
  renderOrders(); renderWarehouse(); renderProductsList();
}
function goBack() {
  document.getElementById('admin-page').classList.remove('active');
  document.getElementById('chat-page').classList.remove('hidden');
}

function switchTab(tab) {
  const tabs   = ['orders','warehouse','products'];
  const btns   = document.querySelectorAll('.tab-btn');
  btns.forEach((b, i) => b.classList.toggle('active', tabs[i] === tab));
  tabs.forEach(t => {
    document.getElementById('tab-' + t).classList.toggle('active', t === tab);
  });
  if (tab === 'warehouse') renderWarehouse();
}

// ── ORDERS ───────────────────────────────────
function renderOrders() {
  const list  = getOrders();
  const tbody = document.getElementById('orders-tbody');
  const empty = document.getElementById('empty-orders');
  document.getElementById('orders-meta').textContent = list.length + ' طلب';

  if (list.length === 0) { tbody.innerHTML = ''; empty.classList.remove('hidden'); return; }
  empty.classList.add('hidden');

  tbody.innerHTML = list.map((o, i) => `
    <tr id="row-${o.id}" class="${o.confirmed ? 'confirmed' : ''}">
      <td>${i + 1}</td>
      <td>${o.name}</td>
      <td dir="ltr">${o.phone}</td>
      <td>${o.product}</td>
      <td>${o.qty}</td>
      <td>${o.wilaya}</td>
      <td style="font-size:12px;color:var(--text-muted);white-space:nowrap;">${o.date}</td>
      <td>
        <button class="btn-action green ${o.confirmed ? 'active-green' : ''}" onclick="confirmRow(${o.id})">
          ${o.confirmed ? 'مؤكد' : 'تاكيد'}
        </button>
      </td>
      <td>
        <button class="btn-action red" onclick="moveToWarehouse(${o.id})">تم الارسال</button>
      </td>
    </tr>`).join('');
}

function confirmRow(id) {
  const list = getOrders();
  const idx  = list.findIndex(o => o.id === id);
  if (idx > -1) { list[idx].confirmed = true; saveOrders(list); renderOrders(); }
}

// Move to warehouse instead of deleting
function moveToWarehouse(id) {
  const orders = getOrders();
  const idx    = orders.findIndex(o => o.id === id);
  if (idx === -1) return;

  const moved    = Object.assign({}, orders[idx], { movedAt: Date.now() });
  const wh       = getWarehouse();
  wh.unshift(moved);          // newest first
  saveWarehouse(wh);

  orders.splice(idx, 1);
  saveOrders(orders);
  renderOrders();
  renderWarehouse();
  showToast('تم نقل الطلب الى المخزن');
}

// ── WAREHOUSE ────────────────────────────────
function renderWarehouse() {
  let wh    = getWarehouse();
  const tbody = document.getElementById('warehouse-tbody');
  const empty = document.getElementById('empty-warehouse');
  const stats = document.getElementById('wh-stats');

  // Total stat
  const total = wh.length;

  // Apply search filter
  const searchVal = (document.getElementById('wh-search') || {value:''}).value.trim().toLowerCase();
  const dateVal   = (document.getElementById('wh-date')   || {value:''}).value;    // YYYY-MM-DD

  let filtered = wh;

  if (searchVal) {
    filtered = filtered.filter(o =>
      o.name.toLowerCase().includes(searchVal) ||
      o.phone.includes(searchVal)
    );
  }

  if (dateVal) {
    filtered = filtered.filter(o => {
      const iso = o.dateISO || '';
      return iso === dateVal;
    });
  }

  // Stats bar
  stats.innerHTML = `
    <div class="wh-stat">الاجمالي: <span>${total}</span></div>
    ${searchVal || dateVal ? `<div class="wh-stat">نتائج البحث: <span>${filtered.length}</span></div>` : ''}
  `;

  if (filtered.length === 0) {
    tbody.innerHTML = '';
    empty.classList.remove('hidden');
    return;
  }
  empty.classList.add('hidden');

  tbody.innerHTML = filtered.map((o, i) => `
    <tr>
      <td>${i + 1}</td>
      <td>${o.name}</td>
      <td dir="ltr">${o.phone}</td>
      <td>${o.product}</td>
      <td>${o.qty}</td>
      <td>${o.wilaya}</td>
      <td style="font-size:12px;color:var(--text-muted);white-space:nowrap;">${o.date}</td>
      <td>
        <button class="btn-action red" onclick="deleteFromWarehouse(${o.id})">حذف نهائي</button>
      </td>
    </tr>`).join('');
}

function deleteFromWarehouse(id) {
  if (!confirm('هل انت متاكد من الحذف النهائي؟')) return;
  saveWarehouse(getWarehouse().filter(o => o.id !== id));
  renderWarehouse();
  showToast('تم الحذف النهائي');
}

function clearWhFilters() {
  document.getElementById('wh-search').value = '';
  document.getElementById('wh-date').value   = '';
  renderWarehouse();
}

// ── PRODUCTS MANAGEMENT ──────────────────────
function renderProductsList() {
  const products  = getProducts();
  const container = document.getElementById('pm-list');
  const empty     = document.getElementById('empty-products');

  if (products.length === 0) { container.innerHTML = ''; empty.classList.remove('hidden'); return; }
  empty.classList.add('hidden');

  container.innerHTML = products.map(p => `
    <div class="pm-card" id="pm-${p.id}">
      ${p.img ? `<img class="pm-card-img" src="${p.img}" alt="${p.name}">` : `<div class="pm-card-noimg">لا صورة</div>`}
      <div class="pm-card-info">
        <div class="pm-card-name">${p.name}</div>
        <div class="pm-card-desc">${p.desc}</div>
        <div class="pm-card-price">${p.price}</div>
      </div>
      <div class="pm-card-actions">
        <button class="pm-btn edit" onclick="openEditModal(${p.id})">تعديل</button>
        <button class="pm-btn del"  onclick="deleteProduct(${p.id})">حذف</button>
      </div>
    </div>`).join('');
}

// ── PRODUCT MODAL ────────────────────────────
let editingId   = null;
let pickedImage = '';

function openProductModal() {
  editingId = null; pickedImage = '';
  document.getElementById('modal-title').textContent = 'اضافة منتج جديد';
  document.getElementById('f-name').value  = '';
  document.getElementById('f-price').value = '';
  document.getElementById('f-desc').value  = '';
  const prev = document.getElementById('f-img-preview');
  prev.src = ''; prev.classList.remove('visible');
  document.getElementById('img-picker-label').textContent = 'اضغط لاختيار صورة من الجهاز';
  document.getElementById('f-img-input').value = '';
  document.getElementById('product-modal').classList.remove('hidden');
}

function openEditModal(id) {
  const p = getProducts().find(x => x.id === id); if (!p) return;
  editingId = id; pickedImage = p.img || '';
  document.getElementById('modal-title').textContent = 'تعديل المنتج';
  document.getElementById('f-name').value  = p.name;
  document.getElementById('f-price').value = p.price;
  document.getElementById('f-desc').value  = p.desc;
  const prev = document.getElementById('f-img-preview');
  if (p.img) { prev.src = p.img; prev.classList.add('visible'); document.getElementById('img-picker-label').textContent = 'اضغط لتغيير الصورة'; }
  else { prev.src = ''; prev.classList.remove('visible'); document.getElementById('img-picker-label').textContent = 'اضغط لاختيار صورة من الجهاز'; }
  document.getElementById('f-img-input').value = '';
  document.getElementById('product-modal').classList.remove('hidden');
}

function closeProductModal() { document.getElementById('product-modal').classList.add('hidden'); editingId = null; pickedImage = ''; }

function onImagePicked(event) {
  const file = event.target.files[0]; if (!file) return;
  const reader = new FileReader();
  reader.onload = (e) => {
    pickedImage = e.target.result;
    const prev = document.getElementById('f-img-preview');
    prev.src = pickedImage; prev.classList.add('visible');
    document.getElementById('img-picker-label').textContent = 'اضغط لتغيير الصورة';
  };
  reader.readAsDataURL(file);
}

function saveProduct() {
  const name  = document.getElementById('f-name').value.trim();
  const price = document.getElementById('f-price').value.trim();
  const desc  = document.getElementById('f-desc').value.trim();
  if (!name)  { alert('يرجى ادخال اسم المنتج'); return; }
  if (!price) { alert('يرجى ادخال سعر المنتج'); return; }
  const products = getProducts();
  if (editingId !== null) {
    const idx = products.findIndex(p => p.id === editingId);
    if (idx > -1) { products[idx].name = name; products[idx].price = price; products[idx].desc = desc; if (pickedImage) products[idx].img = pickedImage; }
  } else {
    products.push({ id: Date.now(), name, price, desc, img: pickedImage || '' });
  }
  saveProducts(products); closeProductModal(); renderProductsList();
  showToast(editingId !== null ? 'تم تعديل المنتج' : 'تم اضافة المنتج');
}

function deleteProduct(id) {
  if (!confirm('هل انت متاكد من حذف هذا المنتج؟')) return;
  saveProducts(getProducts().filter(p => p.id !== id));
  renderProductsList(); showToast('تم حذف المنتج');
}

// ── TOAST ────────────────────────────────────
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg || 'تم الحفظ';
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2800);
}

// ── INIT ─────────────────────────────────────
window.addEventListener('load', startChat);
</script>
</body>
</html>
