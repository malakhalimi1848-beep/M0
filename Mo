<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>TechZone | Premium Electronics Store</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>

<style>
:root{
  --bg:#050505;
  --bg2:#0b0b0b;
  --card:rgba(255,255,255,0.04);
  --card2:rgba(255,255,255,0.06);
  --border:rgba(255,255,255,0.10);
  --text:#f5f5f5;
  --muted:rgba(255,255,255,0.6);
  --accent:#ffffff;
  --radius:18px;
  --shadow: 0 20px 60px rgba(0,0,0,0.6);
  --font:'Inter',sans-serif;
}

*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:var(--font);
  background:var(--bg);
  color:var(--text);
  overflow-x:hidden;
}

/* ===== NAV ===== */
nav{
  position:fixed;
  top:0;
  width:100%;
  height:72px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:0 5%;
  background:rgba(5,5,5,0.7);
  backdrop-filter:blur(20px);
  border-bottom:1px solid var(--border);
  z-index:1000;
}
.logo{
  font-weight:800;
  letter-spacing:-1px;
  font-size:1.2rem;
}
.logo span{opacity:0.6}
.nav-links{
  display:flex;
  gap:24px;
  list-style:none;
}
.nav-links a{
  text-decoration:none;
  color:var(--muted);
  font-size:0.9rem;
  transition:0.2s;
}
.nav-links a:hover{color:var(--text)}
.cta{
  padding:10px 18px;
  border-radius:999px;
  border:1px solid var(--border);
  background:var(--card);
  color:var(--text);
  cursor:pointer;
  transition:0.2s;
}
.cta:hover{transform:translateY(-2px)}

/* ===== HERO ===== */
.hero{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:120px 5% 60px;
}
.hero h1{
  font-size:clamp(2.5rem,6vw,4rem);
  letter-spacing:-2px;
}
.hero p{
  margin-top:18px;
  color:var(--muted);
  max-width:600px;
  margin-inline:auto;
  line-height:1.7;
}
.hero-buttons{
  margin-top:30px;
  display:flex;
  gap:14px;
  justify-content:center;
  flex-wrap:wrap;
}
.btn{
  padding:12px 22px;
  border-radius:999px;
  border:1px solid var(--border);
  background:var(--card);
  color:var(--text);
  cursor:pointer;
  transition:0.2s;
}
.btn:hover{transform:translateY(-3px)}

/* ===== SECTION ===== */
.section{
  padding:80px 5%;
}
.section-title{
  text-align:center;
  font-size:2rem;
  margin-bottom:40px;
  letter-spacing:-1px;
}

/* ===== PRODUCTS ===== */
.products-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:18px;
}

.product-card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  overflow:hidden;
  transform-style:preserve-3d;
  transition:transform 0.2s ease, box-shadow 0.2s ease;
  box-shadow:var(--shadow);
}

.product-img{
  height:180px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:2.5rem;
  background:linear-gradient(145deg,#0a0a0a,#111);
}

.product-body{
  padding:16px;
}

.product-title{
  font-weight:600;
  margin-bottom:6px;
}
.product-meta{
  font-size:0.8rem;
  color:var(--muted);
}
.product-footer{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-top:14px;
}
.price{
  font-weight:700;
}
.add{
  padding:8px 14px;
  border-radius:999px;
  border:1px solid var(--border);
  background:transparent;
  color:var(--text);
  cursor:pointer;
}

/* ===== FEATURES ===== */
.features{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:18px;
}
.feature{
  padding:18px;
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--radius);
}

/* ===== CHAT ===== */
.chat-fab{
  position:fixed;
  bottom:25px;
  left:25px;
  width:58px;
  height:58px;
  border-radius:50%;
  background:var(--card);
  border:1px solid var(--border);
  color:var(--text);
  cursor:pointer;
  z-index:999;
}

.chat-window{
  position:fixed;
  bottom:100px;
  left:25px;
  width:360px;
  height:520px;
  background:var(--bg2);
  border:1px solid var(--border);
  border-radius:20px;
  display:flex;
  flex-direction:column;
  transform:scale(0.9);
  opacity:0;
  pointer-events:none;
  transition:0.3s;
}
.chat-window.open{
  transform:scale(1);
  opacity:1;
  pointer-events:auto;
}

.chat-header{
  padding:14px;
  border-bottom:1px solid var(--border);
  display:flex;
  justify-content:space-between;
}

.messages{
  flex:1;
  padding:14px;
  overflow-y:auto;
}

.msg{
  margin-bottom:10px;
  max-width:80%;
  padding:10px 12px;
  border-radius:14px;
  font-size:0.9rem;
}
.bot{background:var(--card)}
.user{background:#fff;color:#000;margin-left:auto}

.input{
  display:flex;
  padding:10px;
  border-top:1px solid var(--border);
}
.input input{
  flex:1;
  padding:10px;
  border-radius:999px;
  border:1px solid var(--border);
  background:transparent;
  color:var(--text);
}

/* ===== RESPONSIVE ===== */
@media(max-width:600px){
  .nav-links{display:none}
  .chat-window{width:95%;left:2.5%}
}

/* ===== 3D HOVER ===== */
</style>
</head>

<body>

<nav>
  <div class="logo">Tech<span>Zone</span></div>
  <ul class="nav-links">
    <li><a href="#products">Products</a></li>
    <li><a href="#features">Features</a></li>
  </ul>
  <button class="cta" onclick="toggleChat()">Chat</button>
</nav>

<section class="hero">
  <div>
    <h1>Premium Electronics Store</h1>
    <p>Minimal, powerful and futuristic shopping experience with high-end devices and curated technology.</p>
    <div class="hero-buttons">
      <button class="btn" onclick="document.getElementById('products').scrollIntoView({behavior:'smooth'})">Shop Now</button>
      <button class="btn" onclick="toggleChat()">Talk to Assistant</button>
    </div>
  </div>
</section>

<section class="section" id="products">
  <div class="section-title">Featured Products</div>

  <div class="products-grid">

    <div class="product-card">
      <div class="product-img">📱</div>
      <div class="product-body">
        <div class="product-title">Galaxy Ultra</div>
        <div class="product-meta">Flagship smartphone</div>
        <div class="product-footer">
          <div class="price">$999</div>
          <button class="add">Add</button>
        </div>
      </div>
    </div>

    <div class="product-card">
      <div class="product-img">💻</div>
      <div class="product-body">
        <div class="product-title">MacBook Pro</div>
        <div class="product-meta">M-series performance</div>
        <div class="product-footer">
          <div class="price">$1999</div>
          <button class="add">Add</button>
        </div>
      </div>
    </div>

  </div>
</section>

<section class="section" id="features">
  <div class="section-title">Why Choose Us</div>
  <div class="features">
    <div class="feature">Premium Quality Devices</div>
    <div class="feature">Fast Delivery</div>
    <div class="feature">Secure Payments</div>
  </div>
</section>

<!-- CHAT -->
<button class="chat-fab" onclick="toggleChat()">💬</button>

<div class="chat-window" id="chat">
  <div class="chat-header">
    <div>Assistant</div>
    <button onclick="toggleChat()">✕</button>
  </div>

  <div class="messages" id="messages"></div>

  <div class="input">
    <input id="input" placeholder="Type..." onkeydown="if(event.key==='Enter')send()"/>
  </div>
</div>

<script>
let open=false;

function toggleChat(){
  open=!open;
  document.getElementById('chat').classList.toggle('open',open);
  if(open && document.getElementById('messages').children.length===0){
    addBot("مرحباً بك في متجرنا! هل تريد الطلب أم التصفح؟");
  }
}

function addMsg(text,type){
  const div=document.createElement('div');
  div.className='msg '+type;
  div.innerHTML=text;
  document.getElementById('messages').appendChild(div);
}

function addBot(t){addMsg(t,'bot')}
function addUser(t){addMsg(t,'user')}

function send(){
  const i=document.getElementById('input');
  if(!i.value) return;
  addUser(i.value);
  const v=i.value.toLowerCase();
  i.value='';

  if(v.includes('طلب')||v.includes('buy')){
    addBot("هل تريد تأكيد الطلب؟");
  }else{
    addBot("كيف يمكنني مساعدتك؟");
  }
}

/* ===== 3D HOVER EFFECT ===== */
document.querySelectorAll('.product-card').forEach(card=>{
  card.addEventListener('mousemove',(e)=>{
    const r=card.getBoundingClientRect();
    const x=(e.clientX-r.left)/r.width-0.5;
    const y=(e.clientY-r.top)/r.height-0.5;
    card.style.transform=`rotateY(${x*10}deg) rotateX(${y*-10}deg) translateY(-6px)`;
  });
  card.addEventListener('mouseleave',()=>{
    card.style.transform='none';
  });
});
</script>

</body>
</html>
