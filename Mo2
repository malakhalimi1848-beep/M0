</button>

<!-- CHAT WINDOW -->
<div class="chat-window" id="chatWindow">
  <div class="chat-header">
    <div class="chat-avatar">🤖</div>
    <div class="chat-header-info">
      <div class="chat-header-name">ZBot — مساعد TechZone</div>
      <div class="chat-header-status">متصل الآن</div>
    </div>
    <button class="chat-close" onclick="toggleChat()">✕</button>
  </div>
  <div class="chat-messages" id="chatMessages"></div>
  <div class="chat-quick-btns" id="quickBtns"></div>
  <div class="chat-input-area">
    <input class="chat-input" id="chatInput" type="text" placeholder="اكتب رسالتك هنا..." onkeydown="if(event.key==='Enter')sendMsg()">
    <button class="chat-send" onclick="sendMsg()">➤</button>
  </div>
</div>

<script>
  /* ==================== CHAT STATE ==================== */
  let chatOpen = false;
  let step = 'welcome'; // welcome → asked_order → order_info → confirm → done
  let autoOpened = false;

  const storeInfo = `
<b>🏪 مرحباً بك في متجر <span class="highlight">TechZone</span>!</b>

أنا <span class="highlight">ZBot</span>، مساعدك الذكي الشخصي 🤖

هذه نبذة سريعة عن متجرنا:

<ul>
  <li>📍 <span class="gold">الموقع:</span> الجزائر العاصمة، حي باب الزوار</li>
  <li>📞 <span class="gold">الهاتف:</span> 0555 123 456</li>
  <li>⏰ <span class="gold">أوقات العمل:</span> من 9 صباحاً حتى 9 مساءً يومياً</li>
</ul>

<b>📦 ماذا نبيع؟</b>
<ul>
  <li>📱 هواتف ذكية (Samsung، iPhone، Xiaomi، Oppo…)</li>
  <li>💻 حواسيب محمولة (Apple، Dell، HP، Lenovo…)</li>
  <li>📟 أجهزة لوحية (iPad، Samsung Tab، Huawei…)</li>
  <li>🎧 سماعات وملحقات إلكترونية متنوعة</li>
</ul>

<b>✨ مميزاتنا:</b>
<ul>
  <li>✅ منتجات <span class="green">100% أصلية</span> بضمان رسمي لمدة سنة</li>
  <li>🚀 توصيل <span class="green">24-48 ساعة</span> لجميع ولايات الجزائر</li>
  <li>💳 الدفع: نقداً عند الاستلام / CIB / Edahabia</li>
  <li>🔄 إرجاع مجاني خلال 7 أيام</li>
  <li>💰 أسعار تنافسية وعروض دورية</li>
</ul>

هل تريد تقديم <span class="highlight">طلب شراء</span> الآن؟`;

  /* ==================== UTILS ==================== */
  function scrollToProducts(){
    document.getElementById('products').scrollIntoView({behavior:'smooth'});
  }

  function toggleChat(){
    chatOpen = !chatOpen;
    const win = document.getElementById('chatWindow');
    const fab = document.getElementById('chatFab');
    win.classList.toggle('open', chatOpen);
    fab.textContent = chatOpen ? '✕' : '💬';
    if(chatOpen && document.getElementById('chatMessages').children.length === 0){
      setTimeout(()=>botTypeThen(storeInfo, showYesNoButtons), 600);
    }
  }

  function openChat(){
    if(!chatOpen) toggleChat();
  }

  function addMsg(text, sender){
    const msgs = document.getElementById('chatMessages');
    const wrapper = document.createElement('div');
    wrapper.className = `msg ${sender}`;
    if(sender === 'bot'){
      wrapper.innerHTML = `
        <div class="msg-avatar">🤖</div>
        <div class="msg-bubble">${text}</div>`;
    } else {
      wrapper.innerHTML = `<div class="msg-bubble">${text}</div>`;
    }
    msgs.appendChild(wrapper);
    msgs.scrollTop = msgs.scrollHeight;
    return wrapper;
  }

  function showTyping(){
    const msgs = document.getElementById('chatMessages');
    const el = document.createElement('div');
    el.className = 'msg bot';
    el.id = 'typingIndicator';
    el.innerHTML = `
      <div class="msg-avatar">🤖</div>
      <div class="typing-indicator">
        <div class="typing-dot"></div>
        <div class="typing-dot"></div>
        <div class="typing-dot"></div>
      </div>`;
    msgs.appendChild(el);
    msgs.scrollTop = msgs.scrollHeight;
  }

  function removeTyping(){
    const el = document.getElementById('typingIndicator');
    if(el) el.remove();
  }

  function clearQuickBtns(){
    document.getElementById('quickBtns').innerHTML = '';
  }

  function botTypeThen(text, callback, delay=1400){
    showTyping();
    setTimeout(()=>{
      removeTyping();
      addMsg(text, 'bot');
      if(callback) callback();
    }, delay);
  }

  /* ==================== FLOW ==================== */
  function showYesNoButtons(){
    clearQuickBtns();
    const btns = document.getElementById('quickBtns');
    btns.innerHTML = `
      <button class="quick-btn confirm" onclick="handleOrder()">✅ نعم، أريد الطلب</button>
      <button class="quick-btn cancel" onclick="handleNoOrder()">❌ لا، شكراً</button>
      <button class="quick-btn" onclick="handleBrowse()">🛍️ أريد التصفح أولاً</button>`;
    step = 'asked_order';
  }

  function handleOrder(){
    clearQuickBtns();
    addMsg('نعم، أريد الطلب ✅', 'user');
    step = 'order_info';
    const orderMsg = `
<b>🛒 رائع! إليك كيفية تقديم طلبك:</b>

<b>الخطوة 1 — اختر منتجك</b>
<ul>
  <li>تصفح المنتجات في الموقع أو اذكر اسم المنتج هنا</li>
  <li>يمكنك طلب أكثر من منتج في نفس الطلب</li>
</ul>

<b>الخطوة 2 — أرسل لنا معلوماتك</b>
<ul>
  <li>👤 الاسم الكامل</li>
  <li>📞 رقم الهاتف (للتأكيد والتتبع)</li>
  <li>📍 الولاية والعنوان التفصيلي للتوصيل</li>
</ul>

<b>الخطوة 3 — اختر طريقة الدفع</b>
<ul>
  <li>💵 نقداً عند الاستلام</li>
  <li>💳 بطاقة CIB أو Edahabia (مسبقاً)</li>
  <li>🏦 تحويل بنكي</li>
</ul>

<b>الخطوة 4 — التأكيد والتوصيل</b>
<ul>
  <li>✅ سيتصل بك فريقنا خلال أقل من ساعة للتأكيد</li>
  <li>📦 يصلك طلبك خلال <span class="green">24-48 ساعة</span></li>
</ul>

هل أنت متأكد وتريد تأكيد طلبك الآن؟`;
    botTypeThen(orderMsg, showConfirmButtons, 1800);
  }

  function showConfirmButtons(){
    clearQuickBtns();
    const btns = document.getElementById('quickBtns');
    btns.innerHTML = `
      <button class="quick-btn confirm" onclick="handleConfirm()">🎉 نعم، أؤكد طلبي!</button>
      <button class="quick-btn cancel" onclick="handleCancelConfirm()">↩️ لا، أريد التغيير</button>`;
    step = 'confirm';
  }

  function handleConfirm(){
    clearQuickBtns();
    addMsg('نعم، أؤكد طلبي! 🎉', 'user');
    step = 'done';
    botTypeThen(`
<b>🎉 تم تأكيد طلبك بنجاح!</b>

<ul>
  <li>📋 رقم طلبك: <span class="highlight">#TZ-${Math.floor(Math.random()*90000)+10000}</span></li>
  <li>📞 سيتصل بك فريقنا على رقمك قريباً للتأكيد النهائي</li>
  <li>📦 التوصيل خلال <span class="green">24-48 ساعة</span></li>
</ul>

شكراً لثقتك في <span class="highlight">TechZone</span>! 💙
هل تحتاج لأي شيء آخر؟`, showRestartButton, 1600);
  }

  function handleCancelConfirm(){
    clearQuickBtns();
    addMsg('↩️ أريد التغيير', 'user');
    botTypeThen('لا مشكلة! يمكنك التصفح مجدداً واختيار ما يناسبك. هل تريد العودة للبداية؟', showRestartButton, 1000);
  }

  function handleNoOrder(){
    clearQuickBtns();
    addMsg('لا، شكراً ❌', 'user');
    botTypeThen(`
لا بأس! 😊 نحن هنا دائماً عندما تحتاجنا.
<br><br>
يمكنك تصفح منتجاتنا في أي وقت، أو العودة للتحدث معي لأي استفسار.
<br><br>
نتمنى لك يوماً رائعاً! 🌟`, showRestartButton, 1000);
  }

  function handleBrowse(){
    clearQuickBtns();
    addMsg('🛍️ أريد التصفح أولاً', 'user');
    toggleChat();
    scrollToProducts();
    setTimeout(()=>{
      if(!chatOpen) toggleChat();
      botTypeThen('تفضل! 😊 بعد الاطلاع على منتجاتنا، عد إليّ وسأساعدك في الطلب.', showYesNoButtons, 800);
    }, 2000);
  }

  function showRestartButton(){
    clearQuickBtns();
    const btns = document.getElementById('quickBtns');
    btns.innerHTML = `
      <button class="quick-btn" onclick="restartChat()">🔄 بدء من جديد</button>
      <button class="quick-btn" onclick="handleBrowse()">🛍️ تصفح المنتجات</button>`;
  }

  function restartChat(){
    clearQuickBtns();
    document.getElementById('chatMessages').innerHTML = '';
    step = 'welcome';
    setTimeout(()=>botTypeThen(storeInfo, showYesNoButtons), 400);
  }

  function sendMsg(){
    const input = document.getElementById('chatInput');
    const text = input.value.trim();
    if(!text) return;
    input.value = '';
    addMsg(text, 'user');
    clearQuickBtns();

    const lower = text.toLowerCase();
    setTimeout(()=>{
      if(lower.includes('طلب') || lower.includes('شراء') || lower.includes('اشتري')){
        botTypeThen('يسعدني مساعدتك في الطلب! 😊', handleOrder, 900);
      } else if(lower.includes('سعر') || lower.includes('كم') || lower.includes('سعر')){
        botTypeThen('يمكنك الاطلاع على أسعار جميع منتجاتنا في قسم المنتجات أعلاه، أو أخبرني باسم المنتج الذي تريده وسأعطيك سعره الدقيق! 💰', showYesNoButtons, 1000);
      } else if(lower.includes('مرحبا') || lower.includes('اهلا') || lower.includes('هلا')){
        botTypeThen('أهلاً وسهلاً بك! 👋 أنا ZBot مساعد TechZone. كيف يمكنني مساعدتك اليوم؟', showYesNoButtons, 900);
      } else {
        botTypeThen('شكراً على رسالتك! 😊 هل يمكنني مساعدتك في تقديم طلب أو الاستفسار عن منتج معين؟', showYesNoButtons, 1000);
      }
    }, 200);
  }

  // Auto-open chat after 4 seconds
  setTimeout(()=>{
    if(!chatOpen){
      autoOpened = true;
      toggleChat();
    }
  }, 4000);

  // Tab buttons
  document.querySelectorAll('.tab-btn').forEach(btn=>{
    btn.addEventListener('click', function(){
      document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
      this.classList.add('active');
    });
  });
</script>

